# ---------- 依赖 ----------
node_modules/
jspm_packages/

# ---------- 环境变量（含数据库密码，严禁提交） ----------
.env
.env.local
.env.*.local

# ---------- 日志 ----------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------- 测试与覆盖率 ----------
coverage/
.nyc_output/

# ---------- 编辑器 / IDE ----------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.iml

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 构建产物 / 临时文件 ----------
dist/
build/
tmp/
temp/
*.tmp

# 注意：package-lock.json 必须提交，保证 CI 与本地依赖版本一致