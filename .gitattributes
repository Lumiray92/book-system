# 统一换行符：仓库内一律存储 LF，避免 Windows / Linux(CI) 差异
* text=auto eol=lf

# Windows 批处理必须是 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做换行符转换
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary

# 锁文件视为生成物，减少 PR 噪音
package-lock.json linguist-generated=true -diff